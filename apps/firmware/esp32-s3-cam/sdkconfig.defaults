# Target: Seeed XIAO ESP32-S3 Sense (ESP32-S3R8: 8MB octal PSRAM, 8MB QIO flash) + OV3660
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# System
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Network: one HTTP client during registration plus one UDP socket per media stream
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
# A VGA frame is ~25-40 RTP packets sent back to back; deeper TX queues absorb the burst.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64

# Peripherals
CONFIG_I2S_ISR_IRAM_SAFE=y
CONFIG_CAMERA_CORE1=y
